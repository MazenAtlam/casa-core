# --- Build & Logs (Crucial for Colcon) ---
build/
install/
log/
.catkin_tools/
.colcon/
*.pyc

# --- ROS 2 / IDE Specifics ---
.vscode/
.idea/
.DS_Store
*.swp
*~

# --- AMBF and Challenge Repositories ---
# Since you are cloning these repositories, we ignore them to prevent 
# Git from trying to track nested repositories.
src/ambf/
src/surgical_robotics_challenge/
casa_app/ambf/
casa_app/surgical_robotics_challenge/

# --- Large Files Managed by LFS ---
# Ensure these aren't accidentally committed as raw binaries
*.STL
*.dae

# --- OS Specific ---
Thumbs.db
Desktop.ini

# --- Frequently Changing Files ---
src/casa_autonomy_stack/data/expert_demonstrations/
casa_app/casa_autonomy_stack/data/expert_demonstrations/

# --- Datasets ---
casa_app/casa_perception/dataset/processed/
casa_app/casa_perception/dataset/raw/

# --- QA Reviews ---
casa_app/casa_perception/src/mask_generation/qa_review/
casa_app/casa_perception/dataset/

# --- wound extract image ---
casa_app/casa_perception/src/wound_extract/output/

# --- Unity Quest VR app (casa_app/casa_action/unity/AdasrQuestApp) ---
# Generated by Unity, never commit. Assets/, Packages/ and ProjectSettings/ (with their .meta files) ARE committed.
casa_app/casa_action/unity/*/Library/
casa_app/casa_action/unity/*/Temp/
casa_app/casa_action/unity/*/Obj/
casa_app/casa_action/unity/*/Logs/
casa_app/casa_action/unity/*/UserSettings/
casa_app/casa_action/unity/*/Builds/
casa_app/casa_action/unity/*/MemoryCaptures/
casa_app/casa_action/unity/*/Recordings/
casa_app/casa_action/unity/*/.vs/
casa_app/casa_action/unity/*/.gradle/
casa_app/casa_action/unity/*/*.csproj
casa_app/casa_action/unity/*/*.sln
casa_app/casa_action/unity/*/*.suo
casa_app/casa_action/unity/*/*.user
casa_app/casa_action/unity/*/sysinfo.txt

# --- Android / Quest build outputs ---
*.apk
*.aab

# --- ROS 2 bags and ACT demonstrations (large, recorded locally) ---
rosbags/
*.db3
*.mcap
casa_app/casa_action/datasets/
casa_app/casa_action/**/*.hdf5

# --- Python ---
__pycache__/

# --- Unity: TextMesh Pro (imported package content, ~7 MB) ---
# Unity re-imports it on first open: Window > TextMeshPro > Import TMP Essential Resources.
# The essential assets ship with fixed GUIDs, so the scene's TMP references reconnect after import.
casa_app/casa_action/unity/*/Assets/TextMesh Pro/
casa_app/casa_action/unity/*/Assets/TextMesh Pro.meta

# --- Unity: other editor / build artifacts ---
casa_app/casa_action/unity/*/Build/
casa_app/casa_action/unity/*/ExportedObj/
casa_app/casa_action/unity/*/*.pdb
casa_app/casa_action/unity/*/*.mdb
casa_app/casa_action/unity/*/*.opendb
casa_app/casa_action/unity/*/*.VC.db
*.unitypackage
*.symbols.zip
crashlytics-build.properties
